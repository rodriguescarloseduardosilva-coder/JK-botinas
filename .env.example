# SOMENTE no servidor Node. Nunca coloque credenciais em supabase-config.js.
# Ative apenas após habilitação/contratação no BB e validação em homologação.
BB_PIX_ENABLED=false
BB_PIX_ENVIRONMENT=production
# Copie os endpoints de PRODUÇÃO da sua aplicação no Portal Developers BB.
# Não há endereço presumido: somente HTTPS em subdomínios de bb.com.br.
BB_PIX_API_BASE_URL=
BB_PIX_OAUTH_URL=
BB_PIX_APP_KEY=
BB_PIX_CLIENT_ID=
BB_PIX_CLIENT_SECRET=
BB_PIX_CHAVE=
# PEM completo. Em painéis que usam uma linha, pode usar \n para as quebras.
BB_PIX_CERT_PEM=
BB_PIX_KEY_PEM=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Opcional: origem HTTPS exata do próprio site, sem caminho nem barra final.
PIX_SITE_ORIGIN=
